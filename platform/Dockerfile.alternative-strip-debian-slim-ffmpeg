# rsface-server 镜像:strip + lto 瘦镜像 B 方案。
#
# 在当前 debian-slim + ffmpeg 基础上做最小变更:
# - profile.release 加 strip = "symbols" 和 lto = "fat",codegen-units = 1
# - 删 --no-install-recommends 已用
# - 强化层缓存
# 验证 strip 后功能不退化、不破坏 ffmpeg 行为。
#
# 构建:
#   docker build -f platform/Dockerfile.strip -t rsface-server:strip .

FROM rust:1.97-slim AS build
WORKDIR /build

# 缓存层:stub main + stub platform/src,只构建 deps
COPY Cargo.toml Cargo.lock ./
COPY platform/Cargo.toml platform/Cargo.toml
RUN mkdir -p src platform/server/src \
    && echo 'pub fn _stub(){}' > src/lib.rs \
    && echo 'fn main(){}' > src/main.rs \
    && echo 'fn main(){}' > platform/server/src/main.rs \
    && cargo build --release --manifest-path platform/Cargo.toml \
    && rm -rf src platform/server/src

# 真实源码
COPY src ./src
COPY platform ./platform
RUN cargo build --release --manifest-path platform/Cargo.toml

FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/*

COPY --from=build /build/platform/target/release/rsface-server /usr/local/bin/rsface-server
COPY platform/web /app/web
COPY cascade.rfcf /app/cascade.rfcf
RUN mkdir -p /var/rsface-media

ENV BIND_ADDR=0.0.0.0:8080 \
    S3_ENDPOINT=http://rustfs:9000 \
    S3_ACCESS_KEY=rsface \
    S3_SECRET_KEY=rsface-secret \
    S3_BUCKET=rsface \
    WEB_DIR=/app/web \
    RSFACE_CASCADE=/app/cascade.rfcf \
    TMP_DIR=/tmp/rsface-jobs \
    LOCAL_MEDIA_DIR=/var/rsface-media

EXPOSE 8080
CMD ["rsface-server"]
