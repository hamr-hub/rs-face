# rsface-platform GPU 镜像(多阶段构建,支持 NVIDIA CUDA / OpenCL)
# 构建上下文必须是仓库根(需要 core 源码):
#   docker build -f platform/Dockerfile.gpu -t rsface-server:gpu .

FROM rust:1.97-slim AS build
WORKDIR /build
# 先拷贝清单利用层缓存(core 零系统依赖,无需额外 apt 包)。
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY platform ./platform
# examples/ 也是 workspace member — Cargo.toml 里 [[example]] 引用
# cascade_dump / detect_haar / 等示例,build 会去 examples/ 找源。
COPY examples ./examples
# benches/ / tests/ 也被 [[bench]] / [[test]] 引用,Cargo manifest 解析需要这些路径存在。
# (models/ 被 .dockerignore 排除 — Cargo manifest 里只 exclude,不需要 COPY。)
COPY benches ./benches
COPY tests ./tests
# --features cuda-backend 启用 NVIDIA CUDA backend(cudarc 驱动 + NVRTC)。
# 重要:Jetson / Tegra 平台 NVIDIA 不发 OpenCL ICD,所以 RSFACE_USE_GPU=1
# 在 Jetson 上必须靠 cuda-backend 才走得到 GPU;OpenCL 在 Tegra 上永远 silent fail。
# kernel 编译时用 sm_87 arch(Jetson Orin Ampere),cudarc 默认 compute_53
# 在 Tegra driver 540 上 load_ptx 报 CUDA_ERROR_NOT_FOUND "named symbol not found"。
# `liveness` 启用 MiniFASNet 活体检测(tract ONNX 后端)。
# `ort-backend` + `ort-tensorrt` 启用 ONNX Runtime + TensorRT EP(SCRFD/ArcFace GPU 路径)。
RUN cargo build --release --features 'liveness rsface/cuda-backend rsface/ort-backend rsface/ort-tensorrt rsface/ort-cuda' --manifest-path platform/Cargo.toml

# ---- 运行时镜像:Ubuntu 24.04 + CUDA 12.6 + OpenCL ICD + ffmpeg ----
# 必须用 Ubuntu 24.04(noble)以匹配 rust:1.97-slim 的 glibc 2.39;Ubuntu 22.04 只有 2.35。
FROM nvidia/cuda:12.6.0-runtime-ubuntu24.04

# 防止 tzdata 交互
ENV DEBIAN_FRONTEND=noninteractive

# 安装 ffmpeg + OpenCL ICD loader + 常用工具
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg ca-certificates \
        ocl-icd-libopencl1 ocl-icd-opencl-dev \
        libgcc-s1 libstdc++6 \
        curl wget \
    && rm -rf /var/lib/apt/lists/*

# 注册 NVIDIA OpenCL ICD vendor(让 ICD loader 找到 nvidia driver)
RUN mkdir -p /etc/OpenCL/vendors \
    && echo "libnvidia-opencl.so.1" > /etc/OpenCL/vendors/nvidia.icd

# 复制构建产物
COPY --from=build /build/platform/target/release/rsface-server /usr/local/bin/rsface-server
# ONNX Runtime C 库 — Jetson aarch64 wheel(从
# https://github.com/Shattered217/Jetson-Orin-Wheels/releases/tag/6.2.1rc1 下载,
# 内置 CUDA + TensorRT EP,匹配 host JetPack 6.2.1 + TensorRT 10.3.0 + CUDA 12.6)。
# `libonnxruntime.so` 是 ort crate 的 dlopen 目标;provider plugins 通过
# `LIBRARY_PATH` 或 OrtApi 注册,本镜像只装主库 + 提供方即可。
COPY vendor/ort-jetson/lib/onnxruntime/ /opt/onnxruntime/lib/
# entrypoint 会把 bind-mounted host TensorRT/cuDNN/CUDA libs 符号链接到这个目录,
# 镜像里先建好,不然 UID 1000 的非 root user 无法在只读路径里 mkdir。
# chown 给 UID 1000 的运行用户,否则 symlink 创建失败。
RUN mkdir -p /opt/jetson-tensorrt/lib && chown -R 1000:1000 /opt/jetson-tensorrt
COPY platform/web /app/web
# 容器入口:把 bind-mounted host TensorRT/cuDNN/CUDA libs 拼成一个目录,
# 让 LD_LIBRARY_PATH 只用一条路径就能找到所有 ORT TensorRT EP 的依赖。
COPY platform/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
# 级联权重在 src/weights/(随 core 嵌入式分发);容器内路径仍保持 /app/cascade.rfcf。
COPY src/weights/haarcascade_frontalface_default.rfcf /app/cascade.rfcf
# Note: MiniFASNet weights (models/*.onnx) are NOT baked into the image —
# `models/` is in .dockerignore (GB-scale artifacts). Compose bind-mounts
# the host directory into the container at /app/models.
RUN mkdir -p /var/rsface-media /tmp/rsface-jobs \
    # 非 root 运行:rsface 用户(UID 10001)。NVIDIA 设备节点由
    # nvidia-container-cli 注入,权限走 video/render 组,普通用户可访问。
    && groupadd -g 10001 rsface \
    && useradd -u 10001 -g rsface -s /usr/sbin/nologin rsface \
    && chown -R rsface:rsface /var/rsface-media /tmp/rsface-jobs /app

ENV BIND_ADDR=0.0.0.0:8080 \
    S3_ENDPOINT=http://rustfs:9000 \
    S3_ACCESS_KEY=rsface \
    S3_SECRET_KEY=rsface-secret \
    S3_BUCKET=rsface \
    WEB_DIR=/app/web \
    RSFACE_CASCADE=/app/cascade.rfcf \
    TMP_DIR=/tmp/rsface-jobs \
    LOCAL_MEDIA_DIR=/var/rsface-media \
    RSFACE_USE_GPU=1 \
    # MiniFASNet silent face-anti-spoofing models (built into the image).
    # Operators can disable at runtime with RSFACE_LIVENESS_ENABLED=0.
    RSFACE_LIVENESS_ENABLED=${RSFACE_LIVENESS_ENABLED:-1} \
    RSFACE_LIVENESS_MODELS_DIR=/app/models \
    # ONNX Runtime TensorRT/CUDA EP 默认 backend 优先级:TensorRT > CUDA > CPU。
    # ort crate 启动时按此顺序遍历 SessionConfig::with_execution_provider,
    # 第一个能成功注册的就是 active EP。失败自动降级到下一个。
    RSFACE_ARCFACE_BACKEND=${RSFACE_ARCFACE_BACKEND:-auto} \
    RSFACE_ARCFACE_EP=${RSFACE_ARCFACE_EP:-tensorrt} \
    # ORT TensorRT engine cache(避免每次容器启动重建 SM87 engine)。
    # 路径被 ort 内部用 ORT_TENSORRT_ENGINE_CACHE_PATH env 覆盖,这里通过
    # LD_LIBRARY_PATH 顺序先看到 /opt/jetson-tensorrt/lib 后看到 /opt/onnxruntime/lib,
    # 保证 TensorRT EP 找到 host nvinfer 库而不是 apt 装的旧版。
    #
    # 系统库路径(apt 的 libavcodec/libavformat 等,被 ffmpeg 拉起解码图片/视频)
    # 必须放在最前面 — 否则 ffmpeg 启动时 dlopen libavcodec.so.58 找不到,上传的
    # 图片/视频都会被 "ffmpeg image→ppm failed" 兜底,体感是按钮没反应。
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_VISIBLE_DEVICES=all \
    LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu:/opt/onnxruntime/lib:/opt/jetson-tensorrt/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    ORT_TENSORRT_ENGINE_CACHE_PATH=/data/ort-cache

USER rsface
WORKDIR /app
EXPOSE 8080

# 容器级健康检查(镜像已带 curl)。
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD env -u LD_LIBRARY_PATH curl -sf http://127.0.0.1:8080/api/health || exit 1

CMD ["/usr/local/bin/docker-entrypoint.sh"]
