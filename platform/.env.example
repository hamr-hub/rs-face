# 复制为 platform/.env 后按需修改(compose 默认从 compose 文件所在
# 目录读取 .env)。所有值均可缺省,下面列的是 docker-compose.yml 的默认值。

# rustfs / S3 凭据(server 用同一对访问 rustfs)
RUSTFS_ACCESS_KEY=rsface
RUSTFS_SECRET_KEY=rsface-secret

# PostgreSQL 密码;server 的 DATABASE_URL 自动引用同一值。
# 只能用字母数字(勿含 @ : / ? #),否则连接串解析失败。
POSTGRES_PASSWORD=rsface-pass

# 检测参数
MAX_FRAMES_VIDEO=3600
MAX_FACE_CROPS=2000
MIN_FACE_SIZE=24

# 并发 / 排队
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_DEPTH=64

# 任务硬超时(秒;stream 设 0 为不限)
JOB_TIMEOUT_SECS=600
JOB_TIMEOUT_VIDEO_SECS=3600
JOB_TIMEOUT_STREAM_SECS=0

# 停机 / 资源
SHUTDOWN_GRACE_SECS=120
RUSTFS_MEM_LIMIT=1g
PG_MEM_LIMIT=512m
SERVER_MEM_LIMIT=2g
SERVER_MEMSWAP_LIMIT=2g

# 跨域前端(留空 = 同源部署,不开 CORS)
CORS_ALLOW_ORIGIN=
