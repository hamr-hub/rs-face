# 复制为 platform/.env 后按需修改(compose 默认从 compose 文件所在
# 目录读取 .env)。所有值均可缺省,下面列的是 docker-compose.yml 的默认值。

# rustfs / S3 凭据(server 用同一对访问 rustfs)
RUSTFS_ACCESS_KEY=rsface
RUSTFS_SECRET_KEY=rsface-secret

# S3 客户端重试策略:瞬态失败(5xx / 429 / 网络层)按指数退避重试。
# max=4 = 1 首次 + 3 retry,base 100ms * 2^n,封顶 2s。
S3_MAX_RETRIES=4
S3_RETRY_BASE_MS=100
S3_RETRY_MAX_MS=2000

# PostgreSQL 密码;server 的 DATABASE_URL 自动引用同一值。
# 只能用字母数字(勿含 @ : / ? #),否则连接串解析失败。
POSTGRES_PASSWORD=rsface-pass
# PG 连接池最大连接数。默认 16,覆盖要 ≥1;PG `max_connections`
# 默认 100,设太大无意义。
DATABASE_POOL_SIZE=16

# 检测参数
MAX_FRAMES_VIDEO=3600
MAX_FACE_CROPS=2000
MIN_FACE_SIZE=24

# 并发 / 排队
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_DEPTH=64

# 任务硬超时(秒;stream 设 0 为不限)
JOB_TIMEOUT_SECS=600
JOB_TIMEOUT_VIDEO_SECS=3600
JOB_TIMEOUT_STREAM_SECS=0

# 停机 / 资源
SHUTDOWN_GRACE_SECS=120
# docker stop 宽限期(compose stop_grace_period),必须 ≥ SHUTDOWN_GRACE_SECS,
# 否则优雅停机还没跑完容器就被 SIGKILL。
SERVER_STOP_GRACE=2m30s
RUSTFS_MEM_LIMIT=1g
PG_MEM_LIMIT=512m
SERVER_MEM_LIMIT=2g
SERVER_MEMSWAP_LIMIT=2g

# 跨域前端(留空 = 同源部署,不开 CORS)
CORS_ALLOW_ORIGIN=

# 注册人脸画廊目录:每个子目录一个身份,子目录内放该人的 pgm/ppm/png
# 裁剪图。docker compose 默认挂载 ../data/gallery;目录为空时身份识别
# 接口返回 no_gallery,检测类功能不受影响。
RSFACE_GALLERY_DIR=/var/rsface-gallery

# 静默活体检测(MiniFASNet),仅在以 `--features liveness` 构建服务端时生效。
# 先用 tools/fetch_models.sh 拉取两个活体模型到下面的目录,再置 true 开启;
# /identify 每张脸会返回 liveness{is_real, real_score, label}。
RSFACE_LIVENESS_ENABLED=false
RSFACE_LIVENESS_MODELS_DIR=/var/rsface-models
# 判定为真脸所需的最低真脸概率(0 = 纯 argmax;调高更严格、误拒率上升)
RSFACE_LIVENESS_MIN_REAL_SCORE=0.0
