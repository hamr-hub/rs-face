# ---- Rust / Cargo ----
/target/
**/*.rs.bk
Cargo.lock.bak

# Platform server build artifacts (rebuild with `cargo build` inside platform/)
platform/target/

# ---- Build artifacts / generated files ----
# Cascades converted from OpenCV XML via tools/convert_opencv_xml.py are local
# build products — EXCEPT the one shipped in assets/, which is a versioned
# source artifact embedded into the binary via include_bytes! (see
# assets/NOTICE.md for the pinned source hash).
*.rfcf
!assets/*.rfcf

# ---- Local-only user state ----
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Tooling scratch ----
/scratch/
/tmp/
*.tmp
*.bak

# ---- Test outputs ----
test_output/
test_out/
out/
rsface-demo/
*.out.png
*.test.png

# ---- Generated test data ----
# Frames extracted from test videos and binary fixtures used only by local
# reproducers. Generated, not hand-edited.
/fixtures/generated/
data
__pycache__/

# ---- External skill (unrelated to rs-face) ----
# noah-lever-drama-trans-download is a separate short-video download
# tool, kept in the worktree but not part of the rs-face project.
noah-lever-drama-trans-download/

# ---- Platform test fixtures: large binaries only ----
# Small reference images (lena/two-people/biden jpgs) are checked in;
# the large mp4/HLS fixtures are not.
platform/testdata/*.mp4
platform/testdata/hls-loop/

# ---- node_modules ----
# The web/app.js uses no npm deps at runtime — the platform/web folder
# never runs `npm install`. node_modules/ here is leftover from a one-off
# docs build and is intentionally not tracked.
node_modules/

# ---- Local model weights (fetch via tools/fetch_models.sh) ----
models/

# ---- Local tooling / OS junk ----
.meta.yaml
._.DS_Store
**/._.DS_Store
.DS_Store
